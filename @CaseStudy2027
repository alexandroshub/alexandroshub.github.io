<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#0a0a0a;--ink-2:#1a1a1a;--ink-3:#3a3a3a;
  --muted:#6b6b6b;--muted-2:#9a9a9a;
  --border:#e6e6e6;--surface:#f7f7f5;--white:#fff;
  --accent:#2563eb;--accent-glow:rgba(37,99,235,.15);
  --font-display:"Instrument Serif","Georgia",serif;
  --font-body:"Inter",system-ui,sans-serif;
  --font-mono:"JetBrains Mono",ui-monospace,monospace;
  --max-w:820px;
  --ease:cubic-bezier(0.22,1,0.36,1);
}
html{scroll-behavior:smooth;scroll-padding-top:90px;font-size:16px}
body{font-family:var(--font-body);background:var(--white);color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.6}
::selection{background:var(--ink);color:var(--white)}
h1,h2,h3,h4{font-family:var(--font-display);font-weight:400;letter-spacing:-.02em;line-height:1.1}
h1{font-size:clamp(2.5rem,6vw,4.5rem);letter-spacing:-.03em;line-height:1.02}
h2{font-size:clamp(1.75rem,3.5vw,2.4rem);letter-spacing:-.02em;margin-bottom:1.25rem;line-height:1.15}
h3{font-size:1.25rem;margin-bottom:.85rem}
p{font-size:1.0625rem;line-height:1.75;color:var(--ink-3);margin-bottom:1.25rem}
p strong{color:var(--ink);font-weight:600}
a{color:inherit;text-decoration:none}
code{font-family:var(--font-mono);font-size:.9em;background:var(--surface);padding:.15em .45em;border-radius:4px;color:var(--ink);border:1px solid var(--border)}
pre{background:var(--ink);color:#e6e6e6;padding:1.5rem;border-radius:12px;overflow-x:auto;margin:1.5rem 0;font-family:var(--font-mono);font-size:.85rem;line-height:1.6}
pre code{background:none;padding:0;border:none;color:inherit;font-size:inherit}
.container{width:100%;max-width:var(--max-w);margin-inline:auto;padding-inline:clamp(1.25rem,5vw,2rem)}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:.85rem 0;transition:all .3s var(--ease)}
nav.scrolled{background:rgba(255,255,255,.85);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);box-shadow:0 1px 0 var(--border);padding:.65rem 0}
.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:1160px;margin-inline:auto;padding-inline:clamp(1.25rem,5vw,3rem)}
.nav-back{display:inline-flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--ink-3);transition:color .2s}
.nav-back:hover{color:var(--ink)}
.nav-actions{display:flex;gap:.75rem;align-items:center}
.nav-actions a{font-size:.83rem;padding:.55rem 1.1rem;border-radius:100px;transition:all .22s var(--ease)}
.nav-actions a.btn-nav-primary{background:var(--ink);color:var(--white);font-weight:500}
.nav-actions a.btn-nav-primary:hover{background:var(--ink-3);transform:translateY(-1px)}

/* HERO */
.hero{padding:140px 0 60px;position:relative;overflow:hidden;background:radial-gradient(ellipse 900px 600px at 70% 0%,rgba(37,99,235,.06),transparent 60%),linear-gradient(180deg,var(--white),#fdfdfc)}
.hero-eyebrow{display:inline-flex;align-items:center;gap:.5rem;padding:.35rem .85rem;background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.15);border-radius:100px;font-size:.72rem;font-family:var(--font-mono);color:var(--accent);letter-spacing:.04em;margin-bottom:1.5rem;text-transform:uppercase}
.hero h1{margin-bottom:1.5rem;max-width:18ch}
.hero-sub{font-size:1.2rem;color:var(--muted);max-width:56ch;line-height:1.6;margin-bottom:2.5rem}
.hero-meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1.5rem;padding-top:2rem;border-top:1px solid var(--border);margin-top:1rem}
.meta-item{display:flex;flex-direction:column;gap:.25rem}
.meta-label{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-family:var(--font-mono)}
.meta-value{font-family:var(--font-display);font-size:1.05rem;color:var(--ink)}

/* HERO IMAGE */
.hero-image{width:100%;aspect-ratio:16/9;background:var(--ink);border-radius:16px;margin-top:3rem;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
.hero-image::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 40%,rgba(37,99,235,.4),transparent 50%),radial-gradient(circle at 70% 70%,rgba(0,212,170,.2),transparent 50%)}
.hero-image svg{position:relative;z-index:1;width:40%;max-width:280px;opacity:.85}
.hero-image img{width:100%;height:100%;object-fit:cover}

/* CONTENT */
.content{padding:80px 0}
.content section{margin-bottom:5rem;scroll-margin-top:100px}
.content section:last-child{margin-bottom:0}
.section-num{font-family:var(--font-mono);font-size:.75rem;color:var(--muted);letter-spacing:.1em;margin-bottom:.75rem;display:block;text-transform:uppercase}
.content h2 + p {font-size:1.1rem}

/* CALLOUT */
.callout{padding:1.5rem 1.75rem;border-radius:12px;margin:2rem 0;border-left:3px solid var(--ink);background:var(--surface)}
.callout strong{display:block;font-family:var(--font-display);font-size:1.15rem;font-weight:400;margin-bottom:.5rem;color:var(--ink)}
.callout p{margin-bottom:0;font-size:.95rem}
.callout.warn{border-left-color:#dc2626;background:#fef2f2}
.callout.warn strong{color:#991b1b}
.callout.success{border-left-color:#16a34a;background:#f0fdf4}
.callout.success strong{color:#15803d}

/* LIST */
.content ul, .content ol{margin:1.25rem 0 1.75rem 0;padding-left:1.5rem}
.content li{font-size:1.0625rem;line-height:1.75;color:var(--ink-3);margin-bottom:.6rem}
.content li strong{color:var(--ink)}

/* TABLE */
.table-wrap{overflow-x:auto;margin:1.5rem 0;border:1px solid var(--border);border-radius:12px}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{padding:.9rem 1rem;text-align:left;border-bottom:1px solid var(--border)}
th{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-family:var(--font-mono);font-weight:500;background:var(--surface)}
tr:last-child td{border-bottom:none}
td code{font-size:.85em}

/* IMAGE CAPTION */
figure{margin:2rem 0}
figure img, figure .fig-placeholder{width:100%;border-radius:12px;display:block;background:var(--surface)}
.fig-placeholder{aspect-ratio:16/9;background:linear-gradient(135deg,#0a0a0a,#1a1a2e 50%,#0f3460);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.4);font-family:var(--font-mono);font-size:.85rem}
figcaption{font-size:.85rem;color:var(--muted);margin-top:.75rem;text-align:center;font-style:italic}

/* CTA */
.cta-box{background:var(--ink);color:var(--white);padding:clamp(2rem,5vw,3.5rem);border-radius:16px;margin:4rem 0;text-align:center;position:relative;overflow:hidden}
.cta-box::before{content:'';position:absolute;top:-50%;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(37,99,235,.2),transparent 60%);pointer-events:none}
.cta-box h2{color:var(--white);margin-bottom:.75rem;position:relative}
.cta-box p{color:rgba(255,255,255,.6);margin-bottom:2rem;position:relative}
.cta-box a{display:inline-flex;align-items:center;gap:.55rem;padding:.95rem 1.85rem;background:var(--white);color:var(--ink);border-radius:100px;font-size:.9rem;font-weight:500;transition:all .22s var(--ease);position:relative}
.cta-box a:hover{background:var(--accent);color:var(--white);transform:translateY(-2px)}

/* NEXT/PREV NAV */
.project-nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:3rem;padding-top:3rem;border-top:1px solid var(--border)}
.project-nav a{padding:1.5rem;border:1px solid var(--border);border-radius:12px;transition:all .25s var(--ease);display:flex;flex-direction:column;gap:.35rem}
.project-nav a:hover{border-color:var(--ink);transform:translateY(-2px)}
.project-nav .nav-label{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-family:var(--font-mono)}
.project-nav .nav-title{font-family:var(--font-display);font-size:1.15rem;color:var(--ink)}
.project-nav a.next{text-align:right}

/* FOOTER */
footer{background:var(--ink);color:rgba(255,255,255,.4);padding:2rem 0;font-size:.8rem;text-align:center}
footer a{color:rgba(255,255,255,.7);transition:color .2s}
footer a:hover{color:var(--white)}

@media (max-width:640px){
  .hero{padding:110px 0 40px}
  .hero-sub{font-size:1.05rem}
  .project-nav{grid-template-columns:1fr}
  .project-nav a.next{text-align:left}
  pre{font-size:.75rem;padding:1rem}
}
</style>
</head>
